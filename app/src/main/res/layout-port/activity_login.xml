<?xml version="1.0" encoding="utf-8"?>
<!--
  TELA DE LOGIN — mesmo visual do app da LG (webOS).
  Abas: Usuário | Xtream | Lista M3U. Cada aba mostra só os campos dela
  (a LoginActivity liga/desliga os grupos grupoServidor, grupoUsuario,
  grupoSenha e grupoM3u). Serve para celular e TV: a coluna central tem
  largura máxima, então não estica numa tela grande.
  Os ids btnLogin, etUsername, etPassword, layoutLoading, progressBar e
  tvLoadingDots continuam os mesmos de antes (o fluxo de login não mudou).
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_lg">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintWidth_max="460dp"
        app:layout_constraintWidth_percent="0.90"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <!-- Logo: "VLTV" branco + "PLAY" vermelho claro (igual à LG) -->
            <LinearLayout
                android:id="@+id/layoutLogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VLTV"
                    android:textColor="#F5F5F7"
                    android:textSize="38sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="PLAY"
                    android:textColor="#FF4B55"
                    android:textSize="38sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"/>
            </LinearLayout>

            <!-- Espaço reservado para o aviso de licença/teste (próxima etapa) -->
            <TextView
                android:id="@+id/tvLicencaLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#9C9CA8"
                android:textSize="13sp"
                android:layout_marginBottom="12dp"
                android:visibility="gone"/>

            <!-- Abas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/abaUsuario"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Usuário"
                    android:textColor="#9C9CA8"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_lg_aba"
                    android:clickable="true"
                    android:focusable="true"
                    android:nextFocusRight="@id/abaXtream"
                    android:nextFocusDown="@id/etUsername"/>

                <TextView
                    android:id="@+id/abaXtream"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:text="Xtream"
                    android:textColor="#9C9CA8"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_lg_aba"
                    android:clickable="true"
                    android:focusable="true"
                    android:nextFocusLeft="@id/abaUsuario"
                    android:nextFocusRight="@id/abaM3u"/>

                <TextView
                    android:id="@+id/abaM3u"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:text="Lista M3U"
                    android:textColor="#9C9CA8"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_lg_aba"
                    android:clickable="true"
                    android:focusable="true"
                    android:nextFocusLeft="@id/abaXtream"/>
            </LinearLayout>

            <!-- Servidor ou código de parceiro (só Xtream) -->
            <LinearLayout
                android:id="@+id/grupoServidor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Servidor ou código de parceiro"
                    android:textColor="#9C9CA8"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp"/>
                <EditText
                    android:id="@+id/etServidor"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_lg_input"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:hint="http://servidor.com:8080  ou  código"
                    android:textColor="#F5F5F7"
                    android:textColorHint="#5F5F6B"
                    android:textSize="15sp"
                    android:inputType="textUri"
                    android:imeOptions="actionNext"
                    android:singleLine="true"/>
            </LinearLayout>

            <!-- Usuário (Usuário e Xtream) -->
            <LinearLayout
                android:id="@+id/grupoUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Usuário"
                    android:textColor="#9C9CA8"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp"/>
                <EditText
                    android:id="@+id/etUsername"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_lg_input"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#F5F5F7"
                    android:textColorHint="#5F5F6B"
                    android:textSize="16sp"
                    android:inputType="textNoSuggestions"
                    android:imeOptions="actionNext"
                    android:singleLine="true"
                    android:nextFocusDown="@id/etPassword"/>
            </LinearLayout>

            <!-- Senha + olho (Usuário e Xtream) -->
            <LinearLayout
                android:id="@+id/grupoSenha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Senha"
                    android:textColor="#9C9CA8"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <EditText
                        android:id="@+id/etPassword"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_lg_input"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="#F5F5F7"
                        android:textColorHint="#5F5F6B"
                        android:textSize="16sp"
                        android:inputType="textPassword"
                        android:imeOptions="actionDone"
                        android:singleLine="true"
                        android:nextFocusRight="@id/btnOlho"
                        android:nextFocusDown="@id/btnLogin"/>
                    <ImageView
                        android:id="@+id/btnOlho"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="8dp"
                        android:padding="14dp"
                        android:src="@drawable/ic_eye"
                        android:tint="#9C9CA8"
                        android:background="@drawable/bg_lg_input"
                        android:contentDescription="Mostrar senha"
                        android:clickable="true"
                        android:focusable="true"
                        android:nextFocusLeft="@id/etPassword"
                        android:nextFocusDown="@id/btnLogin"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Endereço da lista M3U (só Lista M3U) -->
            <LinearLayout
                android:id="@+id/grupoM3u"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Endereço da lista M3U"
                    android:textColor="#9C9CA8"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp"/>
                <EditText
                    android:id="@+id/etM3u"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_lg_input"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:hint="http://servidor.com/lista.m3u"
                    android:textColor="#F5F5F7"
                    android:textColorHint="#5F5F6B"
                    android:textSize="15sp"
                    android:inputType="textUri"
                    android:imeOptions="actionDone"
                    android:singleLine="true"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="4dp"
                android:text="Entrar"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:stateListAnimator="@null"
                android:background="@drawable/bg_lg_botao"
                android:focusable="true"/>

            <!-- Mensagem de status (erro em vermelho claro), como na LG -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="#9C9CA8"
                android:textSize="14sp"/>

            <!-- Carregando (mesmos ids de antes) -->
            <LinearLayout
                android:id="@+id/layoutLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Conectando ao servidor"
                        android:textColor="#9C9CA8"
                        android:textSize="13sp"/>
                    <TextView
                        android:id="@+id/tvLoadingDots"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="..."
                        android:textColor="#9C9CA8"
                        android:textSize="13sp"
                        android:layout_marginStart="3dp"/>
                </LinearLayout>
                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:indeterminate="true"
                    android:indeterminateTint="#E50914"
                    android:progressTint="#E50914"
                    android:progressBackgroundTint="#2E2E34"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>

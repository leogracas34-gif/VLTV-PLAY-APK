<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#080810">

    <!-- Header fixo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="32dp"
        android:paddingTop="24dp"
        android:paddingBottom="16dp"
        android:background="#080810">

        <TextView
            android:id="@+id/btnBackSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="14dp"
            android:gravity="center"
            android:text="←"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_set_tile"
            android:backgroundTint="#1FFFFFFF"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Configurações"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"/>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1AFFFFFF"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:fillViewport="true">

        <!-- Coluna central com largura máxima -->
        <LinearLayout
            android:layout_width="820dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="48dp">

            <!-- PERFIS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PERFIS"
                android:textColor="#7C7C8A"
                android:textSize="12sp"
                android:letterSpacing="0.15"
                android:textStyle="bold"
                android:paddingTop="20dp"
                android:paddingBottom="10dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvProfilesSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:orientation="horizontal"/>

            <!-- ASSINATURA -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ASSINATURA"
                android:textColor="#7C7C8A"
                android:textSize="12sp"
                android:letterSpacing="0.15"
                android:textStyle="bold"
                android:paddingTop="26dp"
                android:paddingBottom="10dp"/>

            <LinearLayout
                android:id="@+id/cardPlano"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_settings"
                android:layout_marginBottom="10dp"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvPlanoIcone"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:text="⭐"
                        android:textSize="22sp"
                        android:gravity="center"
                        android:background="@drawable/bg_input_round"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:id="@+id/tvNomePlano"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Carregando..."
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvValidadePlano"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Sincronizando com o servidor..."
                            android:textColor="#888888"
                            android:textSize="13sp"/>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvPlanoBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="..."
                        android:textColor="#000000"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:background="@drawable/bg_badge_round"
                        android:visibility="gone"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutProgressoPlano"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp"
                    android:visibility="gone">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#1AFFFFFF"
                        android:layout_marginBottom="14dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:id="@+id/tvDiasRestantes"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="— dias restantes"
                            android:textColor="#AAAAAA"
                            android:textSize="12sp"/>

                        <TextView
                            android:id="@+id/tvDataExpiracao"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#7C7C8A"
                            android:textSize="12sp"/>

                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progressPlano"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:max="100"
                        android:progress="70"
                        android:progressTint="#4CAF50"
                        android:progressBackgroundTint="#222222"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutInfoExtra"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp"
                    android:visibility="gone">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#1AFFFFFF"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvUsuarioConta"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Usuário: —"
                            android:textColor="#7C7C8A"
                            android:textSize="12sp"/>

                        <TextView
                            android:id="@+id/tvStatusConta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="● Ativo"
                            android:textColor="#4CAF50"
                            android:textSize="12sp"/>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- ── Seção Licença do aplicativo (igual à LG: status + código para ativar) ── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LICENÇA DO APLICATIVO"
                android:textColor="#7C7C8A"
                android:textSize="12sp"
                android:letterSpacing="0.15"
                android:textStyle="bold"
                android:paddingTop="26dp"
                android:paddingBottom="10dp"/>

            <LinearLayout
                android:id="@+id/cardLicencaApp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_settings"
                android:layout_marginBottom="10dp"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvLicStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Verificando licença..."
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvLicDetalhe"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text=""
                            android:textColor="#888888"
                            android:textSize="13sp"
                            android:visibility="gone"/>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvLicBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text=""
                        android:textColor="#000000"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:background="@drawable/bg_badge_round"
                        android:visibility="gone"/>

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#1AFFFFFF"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CÓDIGO DO APLICATIVO"
                    android:textColor="#888888"
                    android:textSize="11sp"
                    android:letterSpacing="0.1"
                    android:textStyle="bold"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/tvLicCodigo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="--------"
                        android:textColor="#FFFFFF"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.12"
                        android:maxLines="1"/>

                    <TextView
                        android:id="@+id/btnLicCopiar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Copiar"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="9dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/bg_input_round"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/tvLicAjuda"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text=""
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:visibility="gone"/>

            </LinearLayout>

            <!-- CONTA -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CONTA"
                android:textColor="#7C7C8A"
                android:textSize="12sp"
                android:letterSpacing="0.15"
                android:textStyle="bold"
                android:paddingTop="26dp"
                android:paddingBottom="10dp"/>

            <LinearLayout
                android:id="@+id/cardParental"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_settings"
                android:layout_marginBottom="10dp"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="14dp"
                    android:gravity="center"
                    android:text="🔒"
                    android:textSize="18sp"
                    android:background="@drawable/bg_set_tile"
                    android:backgroundTint="#337B61FF"/>


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Controle Parental"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Bloqueia conteúdo adulto e requer PIN"
                            android:textColor="#888888"
                            android:textSize="13sp"/>

                    </LinearLayout>

                    <Switch
                        android:id="@+id/switchParental"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumbTint="#FFFFFF"
                        android:trackTint="#C1443B"
                        android:focusable="true"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutPin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp"
                    android:visibility="gone">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#1AFFFFFF"
                        android:layout_marginBottom="14dp"/>

                    <TextView
                        android:id="@+id/tvPinSectionLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Segurança do PIN"
                        android:textColor="#AAAAAA"
                        android:textSize="13sp"
                        android:layout_marginBottom="10dp"/>

                    <!-- Montado dinamicamente pelo Kotlin (renderPinSection) -->
                    <LinearLayout
                        android:id="@+id/layoutPinDynamic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>

                </LinearLayout>

            </LinearLayout>

            <!-- APLICATIVO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="APLICATIVO"
                android:textColor="#7C7C8A"
                android:textSize="12sp"
                android:letterSpacing="0.15"
                android:textStyle="bold"
                android:paddingTop="26dp"
                android:paddingBottom="10dp"/>

            <LinearLayout
                android:id="@+id/cardClearCache"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card_settings"
                android:layout_marginBottom="10dp"
                android:padding="20dp"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusDown="@id/cardAbout">
                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="14dp"
                    android:gravity="center"
                    android:text="🧹"
                    android:textSize="18sp"
                    android:background="@drawable/bg_set_tile"
                    android:backgroundTint="#334F8CFF"/>


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Limpar Cache"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Remove imagens e dados temporários"
                        android:textColor="#888888"
                        android:textSize="13sp"/>

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#6A6A78"
                    android:textSize="24sp"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card_settings"
                android:layout_marginBottom="10dp"
                android:padding="20dp"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusUp="@id/cardClearCache"
                android:nextFocusDown="@id/cardTrocarLogin">
                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="14dp"
                    android:gravity="center"
                    android:text="ℹ️"
                    android:textSize="18sp"
                    android:background="@drawable/bg_set_tile"
                    android:backgroundTint="#33A0A0B0"/>


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sobre o Aplicativo"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Versão 1.0.0"
                        android:textColor="#888888"
                        android:textSize="13sp"/>

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#6A6A78"
                    android:textSize="24sp"/>

            </LinearLayout>

            <!-- CREDENCIAIS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CREDENCIAIS"
                android:textColor="#7C7C8A"
                android:textSize="12sp"
                android:letterSpacing="0.15"
                android:textStyle="bold"
                android:paddingTop="26dp"
                android:paddingBottom="10dp"/>

            <LinearLayout
                android:id="@+id/cardTrocarLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card_settings"
                android:layout_marginBottom="10dp"
                android:padding="20dp"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusUp="@id/cardAbout"
                android:nextFocusDown="@id/cardLogout">
                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="14dp"
                    android:gravity="center"
                    android:text="🔑"
                    android:textSize="18sp"
                    android:background="@drawable/bg_set_tile"
                    android:backgroundTint="#33FFB020"/>


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Trocar Credenciais"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvCredenciaisSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Alterar usuário, senha e servidor"
                        android:textColor="#888888"
                        android:textSize="13sp"/>

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#6A6A78"
                    android:textSize="24sp"/>

            </LinearLayout>

            <!-- SESSÃO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SESSÃO"
                android:textColor="#7C7C8A"
                android:textSize="12sp"
                android:letterSpacing="0.15"
                android:textStyle="bold"
                android:paddingTop="26dp"
                android:paddingBottom="10dp"/>

            <LinearLayout
                android:id="@+id/cardLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card_settings"
                android:padding="20dp"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusUp="@id/cardTrocarLogin">
                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="14dp"
                    android:gravity="center"
                    android:text="🚪"
                    android:textSize="18sp"
                    android:background="@drawable/bg_set_tile"
                    android:backgroundTint="#33FF5A5F"/>


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sair da Conta"
                        android:textColor="#C1443B"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Desconecta e volta para o login"
                        android:textColor="#888888"
                        android:textSize="13sp"/>

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#C1443B"
                    android:textSize="24sp"/>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>

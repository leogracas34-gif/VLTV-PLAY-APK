<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- HERO — reduzido em relação ao celular (paisagem tem menos
         altura disponível) -->
    <FrameLayout
        android:id="@+id/layoutHero"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:layout_gravity="top">

        <ImageView
            android:id="@+id/imgBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:alpha="0.9"/>

        <WebView
            android:id="@+id/webViewTrailer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible"
            android:alpha="0"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_gradient_lg_details"/>

        <ProgressBar
            android:id="@+id/trailerLoadingSpinner"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:indeterminateTint="#AAFFFFFF"
            android:visibility="gone"/>

    </FrameLayout>

    <!-- SCROLL -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollDetails"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="220dp"/>

            <!-- Coluna de conteúdo com largura máxima, centralizada —
                 evita texto esticado de ponta a ponta numa TV larga -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_gravity="start">

            <ImageView
                android:id="@+id/imgTitleLogo"
                android:layout_width="360dp"
                android:layout_height="130dp"
                android:layout_gravity="start"
                android:scaleType="fitCenter"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tvRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_lg_tag"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="2dp"
                    android:textColor="#FFD700"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvYear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textColor="#BBBBBB"
                    android:textSize="14sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="HD • 5.1"
                    android:textColor="#BBBBBB"
                    android:textSize="14sp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvGenre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginTop="4dp"
                android:textColor="#BBBBBB"
                android:textSize="14sp"/>

            <LinearLayout
                android:id="@+id/layoutProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="80dp"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ProgressBar
                        android:id="@+id/progressBarMovie"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_weight="1"
                        android:progressDrawable="@drawable/progress_horizontal_disney"/>

                    <TextView
                        android:id="@+id/tvTimeRemaining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Restam 0h0min"
                        android:textColor="#BBBBBB"
                        android:textSize="11sp"/>
                </LinearLayout>
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPlay"
                android:layout_width="420dp"
                android:layout_height="56dp"
                android:layout_gravity="start"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_lg_pill_branco"
                android:text="▶  ASSISTIR"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold"
                android:focusable="true"
                android:nextFocusDown="@id/btnTrailerAction"/>

            <LinearLayout
                android:layout_width="420dp"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center">

                <LinearLayout
                    android:id="@+id/btnRestartAction"
android:background="@drawable/bg_lg_pill"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                                        android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone"
                    android:nextFocusUp="@id/btnPlay"
                    android:nextFocusRight="@id/btnTrailerAction">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_rotate"
                        app:tint="#FFFFFF"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="REINICIAR"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnTrailerAction"
android:background="@drawable/bg_lg_pill"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                                        android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:nextFocusUp="@id/btnPlay"
                    android:nextFocusLeft="@id/btnRestartAction"
                    android:nextFocusRight="@id/btnFavoriteLayout">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_details_trailer"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TRAILER"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnFavoriteLayout"
android:background="@drawable/bg_lg_pill"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                                        android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:nextFocusUp="@id/btnPlay"
                    android:nextFocusLeft="@id/btnTrailerAction"
                    android:nextFocusRight="@id/btnDownloadAction">
                    <ImageButton
                        android:id="@+id/btnFavorite"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@android:color/transparent"
                        android:src="@drawable/ic_details_add"
                        android:focusable="false"
                        app:tint="#FFFFFF"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MINHA LISTA"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnDownloadAction"
android:background="@drawable/bg_lg_pill"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                                        android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:nextFocusUp="@id/btnPlay"
                    android:nextFocusLeft="@id/btnFavoriteLayout"
                    android:nextFocusDown="@id/tabLayoutDetails">
                    <ImageView
                        android:id="@+id/imgDownloadState"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_details_download"/>
                    <TextView
                        android:id="@+id/tvDownloadState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BAIXAR"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvPlot"
                android:layout_width="640dp"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginTop="16dp"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:gravity="start"
                android:maxLines="3"
                android:ellipsize="end"/>

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayoutDetails"
                android:layout_width="640dp"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginTop="18dp"
                android:background="#000000"
                app:tabIndicator="@drawable/custom_tab_indicator"
                app:tabIndicatorColor="#FFFFFF"
                app:tabIndicatorGravity="bottom"
                app:tabIndicatorHeight="2dp"
                app:tabSelectedTextColor="#FFFFFF"
                app:tabTextColor="#88FFFFFF"
                app:tabMode="fixed">
                <com.google.android.material.tabs.TabItem android:text="SUGESTÕES"/>
                <com.google.android.material.tabs.TabItem android:text="EXTRAS"/>
                <com.google.android.material.tabs.TabItem android:text="DETALHES"/>
            </com.google.android.material.tabs.TabLayout>

            <View android:layout_width="640dp" android:layout_height="1dp" android:layout_gravity="start" android:background="#33FFFFFF"/>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:paddingHorizontal="60dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerSuggestions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="visible"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerEpisodes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"/>

                <LinearLayout
                    android:id="@+id/layoutTabDetails"
                    android:layout_width="640dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView android:id="@+id/tvDetailFullTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:layout_marginBottom="10dp"/>
                    <TextView android:id="@+id/tvDetailFullPlot" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#BBBBBB" android:textSize="14sp" android:layout_marginBottom="18dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Duração:" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="13sp"/>
                    <TextView android:id="@+id/tvDetailDuration" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#BBBBBB" android:textSize="13sp" android:layout_marginBottom="10dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Data de lançamento:" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="13sp"/>
                    <TextView android:id="@+id/tvDetailReleaseDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#BBBBBB" android:textSize="13sp" android:layout_marginBottom="10dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gênero:" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="13sp"/>
                    <TextView android:id="@+id/tvDetailGenre" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#BBBBBB" android:textSize="13sp" android:layout_marginBottom="18dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Disponível nos seguintes formatos:" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="13sp"/>
                    <com.google.android.flexbox.FlexboxLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="18dp"
                        app:flexWrap="wrap">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="IMAX ENHANCED" android:background="@drawable/bg_format_tag" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" android:layout_margin="3dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4K ULTRA HD" android:background="@drawable/bg_format_tag" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" android:layout_margin="3dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5.1" android:background="@drawable/bg_format_tag" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" android:layout_margin="3dp"/>
                    </com.google.android.flexbox.FlexboxLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Direção:" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="13sp"/>
                    <TextView android:id="@+id/tvDetailDirector" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#BBBBBB" android:textSize="13sp" android:layout_marginBottom="10dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Elenco:" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="13sp"/>
                    <TextView android:id="@+id/tvCast" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#BBBBBB" android:textSize="13sp"/>
                </LinearLayout>
            </FrameLayout>

            </LinearLayout>

            <!-- Views ocultas para compatibilidade com o código antigo -->
            <TextView android:id="@+id/tvTitle" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <ImageView android:id="@+id/imgPoster" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <Button android:id="@+id/btnSettings" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnResume" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <TextView android:id="@+id/tvEpisodesTitle" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerCast" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <LinearLayout android:id="@+id/btnDownloadArea" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" android:orientation="vertical"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Fora do scroll — z-order mais alto garantido, some via alpha
         no Kotlin junto com o layoutHero ao rolar -->
    <ImageView
        android:id="@+id/btnToggleMute"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:src="@drawable/ic_volume_off"
        android:padding="8dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        android:contentDescription="Mudo"/>

    <ImageButton
        android:id="@+id/btnClose"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_margin="24dp"
        android:visibility="gone"
        android:background="@drawable/bg_circle_dark"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:focusable="true"
        app:tint="#FFFFFF"/>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#000000"
        android:focusable="true"
        app:itemIconTint="@color/white"
        app:itemTextColor="@color/white"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu"/>


    <!-- ✅ NOVO: camada decorativa de tema sazonal — ver overlay_tema_decorativo.xml -->
    <include
        android:id="@+id/overlayTemaSazonal"
        layout="@layout/overlay_tema_decorativo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

</FrameLayout>

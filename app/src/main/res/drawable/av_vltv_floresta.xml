<?xml version="1.0" encoding="utf-8"?>
<!-- Avatar próprio do VLTV (sem personagem): igual ao estilo "floresta" da TV. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#56ab2f"
                android:endColor="#0b6e4f" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:centerX="0.8"
                android:centerY="0.15"
                android:gradientRadius="55%p"
                android:startColor="#4dffffff"
                android:endColor="#00ffffff" />
        </shape>
    </item>
</layer-list>

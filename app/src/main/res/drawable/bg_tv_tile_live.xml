<?xml version="1.0" encoding="utf-8"?>
<!-- Botão grande da Home da TV (estilo LG): degradê + borda branca quando em foco -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FF2A38" android:centerColor="#A81230" android:endColor="#2A1228"/>
            <corners android:radius="14dp"/>
            <stroke android:width="3dp" android:color="#FFFFFF"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#D4101F" android:centerColor="#7A0B22" android:endColor="#1A0F1C"/>
            <corners android:radius="14dp"/>
            <stroke android:width="2dp" android:color="#73FF4B55"/>
        </shape>
    </item>
</selector>

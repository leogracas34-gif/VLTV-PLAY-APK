<?xml version="1.0" encoding="utf-8"?>
<!-- Abas do login (Usuário | Xtream | Lista M3U) — igual ao ".aba" da LG.
     A LoginActivity usa isSelected para marcar a aba ativa:
       normal  = fundo #141416, borda #2E2E34
       ativa   = borda #FF4B55
       foco    = fundo vermelho, borda branca e brilho -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Com foco ou apertada -->
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="4dp" android:color="#80E50914" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item
                android:left="3dp"
                android:top="3dp"
                android:right="3dp"
                android:bottom="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="#E50914" />
                    <stroke android:width="2dp" android:color="#FFFFFF" />
                    <corners android:radius="11dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#E50914" />
            <stroke android:width="2dp" android:color="#FFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Aba ativa -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#141416" />
            <stroke android:width="2dp" android:color="#FF4B55" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Normal -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#141416" />
            <stroke android:width="2dp" android:color="#2E2E34" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>

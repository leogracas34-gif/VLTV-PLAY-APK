<?xml version="1.0" encoding="utf-8"?>
<!-- Avatar próprio do VLTV (sem personagem): igual ao estilo "grafite" da TV. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#485563"
                android:endColor="#29323c" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:centerX="0.28"
                android:centerY="0.2"
                android:gradientRadius="55%p"
                android:startColor="#38ffffff"
                android:endColor="#00ffffff" />
        </shape>
    </item>
</layer-list>

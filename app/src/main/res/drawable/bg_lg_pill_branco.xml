<?xml version="1.0" encoding="utf-8"?>
<!-- Botão ASSISTIR / CONTINUAR — pílula branca com texto preto, como o item
     em foco do menu da LG. No foco ganha o brilho vermelho em volta. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Com foco -->
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="4dp" android:color="#8CE50914" />
                    <corners android:radius="30dp" />
                </shape>
            </item>
            <item
                android:left="3dp"
                android:top="3dp"
                android:right="3dp"
                android:bottom="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="#FFFFFF" />
                    <corners android:radius="27dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Apertado -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#D9D9DE" />
            <corners android:radius="28dp" />
        </shape>
    </item>

    <!-- Normal -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</selector>

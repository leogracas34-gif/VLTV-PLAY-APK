<?xml version="1.0" encoding="utf-8"?>
<!-- Campo de texto / caixa do código — igual ao "input" da LG:
     fundo #141416, borda #2E2E34; no foco a borda fica #FF4B55 com brilho vermelho. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Com foco (teclado, controle remoto ou toque no campo) -->
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="4dp" android:color="#59E50914" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item
                android:left="3dp"
                android:top="3dp"
                android:right="3dp"
                android:bottom="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="#141416" />
                    <stroke android:width="2dp" android:color="#FF4B55" />
                    <corners android:radius="11dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Normal -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#141416" />
            <stroke android:width="2dp" android:color="#2E2E34" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>

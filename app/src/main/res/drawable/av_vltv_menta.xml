<?xml version="1.0" encoding="utf-8"?>
<!-- Avatar próprio do VLTV (sem personagem): igual ao estilo "menta" da TV. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:startColor="#11998e"
                android:endColor="#38ef7d" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:centerX="0.75"
                android:centerY="0.2"
                android:gradientRadius="55%p"
                android:startColor="#59ffffff"
                android:endColor="#00ffffff" />
        </shape>
    </item>
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<!--
=============================================================
  VLTV Play — AndroidManifest
  - Launcher: SplashActivity (MAIN/LAUNCHER direto na Activity).
  - ❌ Removidos: ícones sazonais (activity-alias) e jogos retrô.
  - ✅ AtivacaoActivity: tela de ativação da licença (igual à LG).
=============================================================
-->

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Necessárias pro download em segundo plano do Media3 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:name=".VLTVApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:logo="@mipmap/ic_launcher_round"
        android:banner="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="VLTV+"
        android:supportsRtl="true"
        android:theme="@style/Theme.VLTVPlay"
        android:networkSecurityConfig="@xml/network_security_config"
        android:launchMode="singleTask"
        android:resizeableActivity="true"
        tools:targetApi="31">

        <!-- ✅ SplashActivity — é o launcher de verdade (celular e TV).
             ❌ REMOVIDO: os 7 activity-alias de ícone sazonal (Normal, Copa,
             Halloween, Crianças, Natal, Ano Novo, Carnaval). O MAIN/LAUNCHER
             agora mora direto na Activity. DECISÃO DE ARQUITETURA: o Android
             guarda no aparelho qual alias estava ligado, e esse estado
             sobrevive à atualização — quem estava com um alias sazonal
             ligado e o ".LauncherNormal" desligado ficaria SEM ícone se
             apenas trocássemos os aliases. Uma Activity nunca fica
             "desligada" por esse mecanismo, então o ícone sempre aparece. -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.VLTVPlay.Splash"
            android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ✅ NOVO: tela de ativação da licença (igual à da LG) -->
        <activity
            android:name=".AtivacaoActivity"
            android:exported="false"
            android:theme="@style/Theme.VLTVPlay"
            android:screenOrientation="unspecified" />

        <!-- LoginActivity: voltou ao tema normal, não é mais a entrada
             direta do app (a SplashActivity que navega até ela). -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.VLTVPlay"
            android:screenOrientation="unspecified" />

        <!-- ✅ NOVO (temporário, pra debug): tela que mostra o stacktrace
             completo quando o app crasha, em vez de só fechar. -->
        <activity
            android:name=".CrashActivity"
            android:exported="false"
            android:theme="@style/Theme.VLTVPlay"
            android:screenOrientation="unspecified" />

        <activity
            android:name=".HomeActivity"
            android:banner="@mipmap/ic_launcher"
            android:exported="true"
            android:screenOrientation="unspecified" />

        <!-- ✅ CORRIGIDO: adicionado supportsPictureInPicture e
             resizeableActivity, faltavam aqui (a PlayerActivity já
             tinha). Sem eles o enterPictureInPictureMode() do Kotlin
             era recusado pelo sistema com IllegalStateException. -->
        <activity
            android:name=".LiveTvActivity"
            android:banner="@mipmap/ic_launcher"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection|keyboardHidden"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".PlayerActivity"
            android:banner="@mipmap/ic_launcher"
            android:supportsPictureInPicture="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden"
            android:resizeableActivity="true"
            android:screenOrientation="sensorLandscape" />

        <activity android:name=".VodActivity" android:banner="@mipmap/ic_launcher" android:screenOrientation="unspecified" />
        <activity android:name=".DetailsActivity" android:banner="@mipmap/ic_launcher" android:screenOrientation="unspecified" />
        <activity android:name=".SeriesActivity" android:banner="@mipmap/ic_launcher" android:screenOrientation="unspecified" />
        <activity android:name=".SeriesDetailsActivity" android:banner="@mipmap/ic_launcher" android:screenOrientation="unspecified" />

        <!-- ✅ CORRIGIDO: adjustNothing evita que o BottomNavigationView
             suba junto com o teclado ao abrir a busca (ver nota acima). -->
        <activity
            android:name=".SearchActivity"
            android:banner="@mipmap/ic_launcher"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustNothing" />

        <activity android:name=".SettingsActivity" android:banner="@mipmap/ic_launcher" android:screenOrientation="unspecified" />
        <activity android:name=".DownloadsActivity" android:banner="@mipmap/ic_launcher" android:screenOrientation="unspecified" />
        <activity android:name=".KidsActivity" android:banner="@mipmap/ic_launcher" android:screenOrientation="unspecified" android:exported="false" />
        <activity android:name=".ProfilesActivity" android:exported="false" android:screenOrientation="unspecified" android:theme="@style/Theme.AppCompat.NoActionBar" />
        <activity android:name=".NovidadesActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".EditProfileActivity" />
        <activity android:name=".TmdbDetailsActivity" />
        <activity android:name=".SeriesEpisodesActivity" />
        <activity android:name=".KidsDownloadsActivity" android:exported="false" />
        <activity android:name=".KidsSeriesEpisodesActivity" android:exported="false" />
        <activity android:name=".KidsMovieDownloadActivity" android:exported="false" />

        <!-- Tela dedicada de gerenciamento de download de um filme
             (equivalente à SeriesEpisodesActivity, mas para filme avulso) -->
        <activity android:name=".MovieDownloadActivity" android:screenOrientation="unspecified" android:exported="false" />

        <!-- Serviço de foreground que mantém os downloads do
             Media3 rodando em segundo plano com notificação -->
        <service
            android:name=".download.VltvDownloadService"
            android:foregroundServiceType="dataSync"
            android:exported="false">
            <intent-filter>
                <action android:name="androidx.media3.exoplayer.downloadService.action.RESTART" />
            </intent-filter>
        </service>

    </application>

</manifest>
